# Mapbox public token, baked into the JS bundle at build time. Restrict it to
# your production domain(s) + *.vercel.app at mapbox.com/account/access-tokens.
VITE_MAPBOX_TOKEN=your-mapbox-token-here

# Congress.gov API key, used server-side only by frontend/api/legislation.ts
# and frontend/api/report-card.ts (Vercel serverless functions). Set this in
# the Vercel dashboard's environment variables — never prefix it with VITE_.
# CONGRESS_API_KEY=your-congress-gov-key-here
